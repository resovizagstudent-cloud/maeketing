function submitReport() {
  const user = auth.currentUser;

  db.collection("users").doc(user.uid).get().then(doc => {
    const name = doc.data().name;

    db.collection("reports").add({
      userId: user.uid,
      name: name,
      date: document.getElementById("date").value,
      totalCalling: Number(document.getElementById("totalCalling").value),
      connectedCalls: Number(document.getElementById("connectedCalls").value),
      positiveCalls: Number(document.getElementById("positiveCalls").value),
      doorVisiting: Number(document.getElementById("doorVisiting").value),
      closedAdmission: Number(document.getElementById("closedAdmission").value),
      created: new Date()
    }).then(() => alert("Submitted"));
  });
}
